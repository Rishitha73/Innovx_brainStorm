{
  "manifest_version": 3,
  "name": "Pre-Submission Error Guard",
  "version": "1.0.0",
  "description": "Client-side pre-submission error guard for official forms and scholarship applications.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/opencv.js",
        "config/portalConfig.js",
        "validators/fileValidator.js",
        "analyzers/qualityAnalyzer.js",
        "detectors/formDetector.js",
        "detectors/fileDetector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pre-Submission Error Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
